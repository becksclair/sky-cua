{
  "fixture_version": 1,
  "protocol": "JSON-RPC 2.0 over newline-delimited stdio",
  "modern_canonical": {
    "initialize": {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "elicitation": {
              "form": {}
            }
          },
          "clientInfo": {
            "name": "fixture-client",
            "version": "1.0.0"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": true
            }
          },
          "serverInfo": {
            "name": "node_repl",
            "version": "0.1.0"
          },
          "instructions_fixture": "contract.json#/mcp/initialize/instructions"
        }
      }
    },
    "initialized": {
      "request": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized",
        "params": {}
      },
      "response": null
    },
    "tools_list": {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/list",
        "params": {}
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 2,
        "result_fixture": "tools-list.json"
      }
    },
    "tools_call": {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "js",
          "arguments": {
            "title": "Inspect a value",
            "code": "nodeRepl.write(\"hello\")"
          },
          "_meta": {
            "session_id": "session-fixture",
            "turn_id": "turn-fixture",
            "x-codex-turn-metadata": {
              "session_id": "session-fixture",
              "turn_id": "turn-fixture"
            }
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "hello"
            }
          ],
          "isError": false
        }
      }
    },
    "unknown_tool_call": {
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "tools/call",
        "params": {
          "name": "computer_use",
          "arguments": {
            "action": "click"
          }
        }
      },
      "response_contract": {
        "isError": true,
        "content_type": "text",
        "must_not": "forward arbitrary MCP tools/call into the kernel"
      }
    }
  },
  "js_cases": [
    {
      "id": "write-string",
      "request_id": 10,
      "arguments": {
        "code": "nodeRepl.write(\"hello\")"
      },
      "kernel_result": {
        "ok": true,
        "output": "hello",
        "error": null
      },
      "mcp_content": [
        {
          "type": "text",
          "text": "hello"
        }
      ]
    },
    {
      "id": "persistent-binding",
      "calls": [
        {
          "request_id": 11,
          "arguments": {
            "code": "var counter = 41; nodeRepl.write(counter)"
          },
          "kernel_result": {
            "ok": true,
            "output": "41",
            "error": null
          }
        },
        {
          "request_id": 12,
          "arguments": {
            "code": "nodeRepl.write(counter + 1)"
          },
          "kernel_result": {
            "ok": true,
            "output": "42",
            "error": null
          }
        }
      ]
    },
    {
      "id": "top-level-await",
      "request_id": 13,
      "arguments": {
        "code": "await Promise.resolve(); nodeRepl.write(\"awaited\")"
      },
      "kernel_result": {
        "ok": true,
        "output": "awaited",
        "error": null
      }
    },
    {
      "id": "error",
      "request_id": 14,
      "arguments": {
        "code": "throw new Error(\"fixture failure\")"
      },
      "kernel_result": {
        "ok": false,
        "output": "",
        "error": "fixture failure"
      },
      "mcp_result_contract": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "fixture failure"
          }
        ]
      }
    },
    {
      "id": "custom-timeout",
      "request_id": 15,
      "arguments": {
        "code": "await new Promise(() => {})",
        "timeout_ms": 25
      },
      "expected_error": "lifecycle.json#/timeout"
    }
  ],
  "js_reset": {
    "request": {
      "jsonrpc": "2.0",
      "id": 20,
      "method": "tools/call",
      "params": {
        "name": "js_reset",
        "arguments": {}
      }
    },
    "kernel_effect": "new generation with no prior bindings or active native connections; module search roots remain",
    "tool_value": true,
    "mcp_text_value": "true"
  },
  "js_add_node_module_dir": {
    "first_request": {
      "jsonrpc": "2.0",
      "id": 21,
      "method": "tools/call",
      "params": {
        "name": "js_add_node_module_dir",
        "arguments": {
          "path": "/fixture/packages/node_modules"
        }
      }
    },
    "first_result": true,
    "duplicate_request": {
      "jsonrpc": "2.0",
      "id": 22,
      "method": "tools/call",
      "params": {
        "name": "js_add_node_module_dir",
        "arguments": {
          "path": "/fixture/packages/node_modules"
        }
      }
    },
    "duplicate_result": false,
    "persistence_after_reset": true,
    "invalid_cases": [
      {
        "arguments": {},
        "expected": "schema validation error"
      },
      {
        "arguments": {
          "path": "relative/node_modules"
        },
        "expected": "absolute path validation error"
      }
    ]
  },
  "legacy_linux_observed": {
    "probe": "resources/node_repl",
    "initialize_response": {
      "protocolVersion": "2025-06-18",
      "capabilities": {
        "tools": {
          "listChanged": true
        }
      },
      "serverInfo": {
        "name": "rmcp",
        "version": "1.5.0"
      }
    },
    "tools_observed": ["js", "js_reset"],
    "js_call_response": {
      "content": [
        {
          "type": "text",
          "text": "hello"
        }
      ],
      "isError": false
    },
    "js_reset_response": {
      "content": [
        {
          "type": "text",
          "text": "js kernel reset"
        }
      ],
      "isError": false
    },
    "probe_note": "This transcript is retained to prove the legacy Linux wire envelope only; modern tool names/descriptions come from the Darwin artifact."
  }
}
