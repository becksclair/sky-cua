{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/contracts/cua-node/blocked-lock.schema.json",
  "title": "Codex cua_node explicitly blocked lock",
  "description": "Canonical unresolved lock form used when required runtime or native inputs are explicitly blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lock_version", "target", "status", "blockers"],
  "properties": {
    "schema_version": { "const": 1 },
    "lock_version": { "const": 1 },
    "target": { "const": "linux-x64-glibc" },
    "status": { "const": "blocked" },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/blocker" }
    }
  },
  "$defs": {
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "approval", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "approval": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
