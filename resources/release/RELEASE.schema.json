{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heliasar.com/sky-cua/schemas/release-v1.json",
  "title": "sky-cua immutable component release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compat_version",
    "release_id",
    "producer",
    "target",
    "components",
    "runtime",
    "trusted_browser_client_sha256s",
    "locks",
    "artifacts",
    "capabilities",
    "browser_contract"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "compat_version": { "const": 1 },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "source_date_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "libc", "triple"],
      "properties": {
        "os": { "const": "linux" },
        "arch": { "const": "x86_64" },
        "libc": { "const": "glibc" },
        "triple": { "const": "x86_64-unknown-linux-gnu" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "runtime": {
      "type": "object",
      "required": [
        "node",
        "node_repl",
        "browser_use",
        "sky_cua_js",
        "playwright",
        "pdfjs",
        "tesseract_js",
        "sharp",
        "sharp_linux_x64",
        "sharp_libvips_linux_x64",
        "canvas_linux_x64_gnu",
        "pixelmatch",
        "codecs"
      ],
      "properties": {
        "node": { "const": "24.14.0" },
        "node_repl": { "type": "string", "minLength": 1 },
        "browser_use": { "type": "string", "minLength": 1 },
        "sky_cua_js": { "type": "string", "minLength": 1 },
        "playwright": { "const": "1.57.0" },
        "pdfjs": { "const": "5.4.624" },
        "tesseract_js": { "const": "7.0.0" },
        "sharp": { "const": "0.34.5" },
        "sharp_linux_x64": { "const": "0.34.5" },
        "sharp_libvips_linux_x64": { "const": "1.2.4" },
        "canvas_linux_x64_gnu": { "const": "0.1.91" },
        "pixelmatch": { "type": "string", "minLength": 1 },
        "codecs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "trusted_browser_client_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "locks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/hashedArtifact" }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 3,
      "required": ["sbom", "provenance", "licenses"],
      "additionalProperties": { "$ref": "#/$defs/hashedArtifact" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "unsupported"],
      "properties": {
        "supported": { "$ref": "#/$defs/stringSet" },
        "unsupported": { "$ref": "#/$defs/stringSet" }
      }
    },
    "browser_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_schema_version",
        "command_schema_version",
        "caller_provenance",
        "transport_identities",
        "no_ambiguous_mutation_retry",
        "canonical_browser",
        "compatibility_projections"
      ],
      "properties": {
        "api_schema_version": { "type": "integer", "minimum": 1 },
        "command_schema_version": { "type": "integer", "minimum": 1 },
        "caller_provenance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["codex_desktop", "direct_mcp", "openclaw", "opencode"]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "transport_identities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["extension_native_host", "host_provided_iab"] },
          "minItems": 2,
          "maxItems": 2
        },
        "no_ambiguous_mutation_retry": { "const": true },
        "canonical_browser": { "$ref": "#/$defs/browserBinding" },
        "extension_bridge": { "$ref": "#/$defs/extensionBridge" },
        "compatibility_projections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/browserBinding" }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "api_inventory",
        "capability_inventory",
        "example_inventory",
        "routing_inventory"
      ],
      "properties": {
        "component": { "const": "documentation" },
        "api_inventory": { "$ref": "#/$defs/hashedArtifact" },
        "capability_inventory": { "$ref": "#/$defs/hashedArtifact" },
        "example_inventory": { "$ref": "#/$defs/hashedArtifact" },
        "routing_inventory": { "$ref": "#/$defs/hashedArtifact" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "browserBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "path", "sha256"],
      "properties": {
        "component": { "enum": ["browser-js", "codex-compat"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "extensionBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "extension_id",
        "version",
        "path",
        "manifest_sha256",
        "tree_sha256"
      ],
      "properties": {
        "component": { "const": "core-linux-x64" },
        "extension_id": { "type": "string", "pattern": "^[a-p]{32}$" },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "tree_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "archive",
        "dependencies",
        "required",
        "profiles",
        "sha256",
        "size",
        "tree_size",
        "tree_sha256"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "archive": { "$ref": "#/$defs/relativePath" },
        "dependencies": { "$ref": "#/$defs/stringSet" },
        "required": { "type": "boolean" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["full", "core-only"] }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "tree_size": { "type": "integer", "minimum": 0 },
        "tree_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
