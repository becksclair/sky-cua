<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SkyPhoneCompanion" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sky_bg</item>
        <item name="android:statusBarColor">@color/sky_bg</item>
        <item name="android:navigationBarColor">@color/sky_bg</item>
        <item name="colorPrimary">@color/sky_primary</item>
        <item name="colorPrimaryDark">@color/sky_bg</item>
        <item name="colorAccent">@color/sky_primary</item>
        <item name="android:textColorPrimary">@color/sky_text</item>
        <item name="android:textColorHighlight">@color/sky_secondary</item>
        <!-- Light background -> dark status/nav icons. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
