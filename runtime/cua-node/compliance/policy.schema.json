{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/compliance/cua-node-policy.schema.json",
  "title": "Linux cua_node compliance policy",
  "description": "A fail-closed compliance registry for the planned Linux x64 glibc cua_node runtime. It records dispositions separately from the runtime and native asset locks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "target",
    "release_status",
    "determinism",
    "external_requirements",
    "dispositions",
    "components",
    "blocking_gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "linux-cua-node-compliance"
    },
    "target": {
      "const": "linux-x64-glibc"
    },
    "release_status": {
      "enum": ["blocked", "clear"]
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_timestamp", "component_sort_key", "network_access"],
      "properties": {
        "fixed_timestamp": {
          "const": "1970-01-01T00:00:00Z"
        },
        "component_sort_key": {
          "const": "id"
        },
        "network_access": {
          "const": "not-used"
        }
      }
    },
    "external_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/external_requirement"
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/disposition"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "blocking_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "external_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platform", "requirement", "redistribution", "sbom_distribution_component", "notes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "runtime-dependency"
        },
        "platform": {
          "const": "linux"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "const": "not-redistributed"
        },
        "sbom_distribution_component": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "release_blocking", "required_evidence"],
      "properties": {
        "id": {
          "enum": [
            "routine-notice-clearance",
            "provenance-only-gate",
            "unresolved-evidence-gate"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "release_blocking": {
          "type": "boolean"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_expression", "designation"],
      "properties": {
        "spdx_expression": {
          "type": "string",
          "minLength": 1
        },
        "designation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "kind",
        "purl",
        "disposition",
        "release_effect",
        "license",
        "source",
        "notice_ids",
        "blocking_gate_ids",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "purl": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "routine-notice-clearance",
            "provenance-only-gate",
            "unresolved-evidence-gate"
          ]
        },
        "release_effect": {
          "enum": ["notice-clearance-required", "blocking-gate-open"]
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "kind", "provenance_status"],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "provenance_status": {
              "enum": [
                "planned-authoritative-source",
                "artifact-provenance-resolved",
                "provenance-unresolved",
                "evidence-unresolved"
              ]
            }
          }
        },
        "notice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocking_gate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "blocking",
        "component_ids",
        "required_evidence",
        "source_offer_required",
        "acceptance",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["provenance-only", "unresolved-evidence"]
        },
        "status": {
          "const": "open"
        },
        "blocking": {
          "const": true
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "source_offer_required": {
          "type": "boolean"
        },
        "source_offer_template": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "acceptance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "missing"
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
