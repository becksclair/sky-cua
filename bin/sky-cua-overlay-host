#!/bin/sh
set -eu

case "$(uname -m)" in
  x86_64|amd64)
    sky_cua_platform="linux-x64"
    ;;
  aarch64|arm64)
    sky_cua_platform="linux-arm64"
    ;;
  *)
    echo "sky-cua-overlay-host: unsupported Linux architecture: $(uname -m)" >&2
    exit 127
    ;;
esac

# Resolve symlinked invocation so the bundled runtime is found next to the
# real wrapper, not next to the symlink.
script_path=$0
while [ -h "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path="$(dirname -- "$script_path")/$link_target" ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
bundled_runtime="$script_dir/runtimes/$sky_cua_platform/sky-cua-overlay-host"
if [ -x "$bundled_runtime" ]; then
  exec "$bundled_runtime" "$@"
fi

source_runtime="$script_dir/../target/release/sky-cua-overlay-host"
exec "$source_runtime" "$@"
