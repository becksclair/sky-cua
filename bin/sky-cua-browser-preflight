#!/bin/sh
set -eu

# Resolve symlinked invocation so the bundled preflight script is found next
# to the real wrapper, not next to the symlink.
script_path=$0
while [ -h "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path="$(dirname -- "$script_path")/$link_target" ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
exec python3 "$script_dir/../resources/chrome_preflight.py" "$@"
