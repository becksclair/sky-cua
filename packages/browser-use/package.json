{
  "name": "@heliasar/browser-use",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/browser-client.mjs"
    },
    "./projection": "./src/projection.ts"
  },
  "files": [
    "build",
    "fixtures"
  ],
  "scripts": {
    "build": "bun run src/build.ts",
    "fixtures": "bun run src/generate-fixtures.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "verify": "bun run fixtures && bun run build && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.14.0"
  }
}
