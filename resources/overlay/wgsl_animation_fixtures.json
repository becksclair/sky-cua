{
  "schema_version": 1,
  "description": "Deterministic desktop WGPU shader samples for Phase 4 conformance tests. Values are generated from the shared overlay spec constants and the same representative tap/no-no frame inputs used by the Rust WGPU tests.",
  "tolerance": {
    "default": 0.01,
    "alpha": 0.02
  },
  "fixtures": {
    "tap_midpoint": {
      "surface": { "width": 96, "height": 96 },
      "elapsed_ms": 190,
      "duration_ms": 380,
      "points": [{ "x": 50.0, "y": 60.0 }],
      "expected": {
        "progress": 0.5,
        "ripple_radius": 42.0,
        "ripple_alpha": 0.5,
        "cursor": { "x": 50.0, "y": 60.0 },
        "cursor_scale": 1.076789,
        "edge_glow_alpha": 0.364,
        "trail_probe_alpha": 0.0
      }
    },
    "tap_offquarter": {
      "surface": { "width": 96, "height": 96 },
      "elapsed_ms": 114,
      "duration_ms": 380,
      "points": [{ "x": 50.0, "y": 60.0 }],
      "expected": {
        "progress": 0.3,
        "ripple_radius": 29.504,
        "ripple_alpha": 0.7,
        "cursor_scale": 0.813508
      }
    },
    "no_no_midshake": {
      "surface": { "width": 96, "height": 96 },
      "elapsed_ms": 380,
      "duration_ms": 760,
      "points": [{ "x": 50.0, "y": 60.0 }],
      "expected": {
        "progress": 0.5,
        "rotation_offset_deg": -20.0
      }
    },
    "no_no_tail": {
      "surface": { "width": 96, "height": 96 },
      "elapsed_ms": 780,
      "duration_ms": 1000,
      "points": [{ "x": 50.0, "y": 60.0 }],
      "expected": {
        "progress": 0.78,
        "rotation_offset_deg": 17.526134
      }
    },
    "swipe_slide": {
      "surface": { "width": 96, "height": 96 },
      "elapsed_ms": 475,
      "duration_ms": 950,
      "points": [{ "x": 50.0, "y": 60.0 }, { "x": 80.0, "y": 60.0 }],
      "expected": {
        "progress": 0.5,
        "cursor_scale": 1.076789,
        "rotation_deg": 0.0,
        "trail_probe_alpha": 0.745098
      }
    },
    "rotation_passthrough": {
      "surface": { "width": 96, "height": 96 },
      "elapsed_ms": 190,
      "duration_ms": 380,
      "points": [{ "x": 50.0, "y": 60.0 }],
      "cursor_rotation_deg": 37.5,
      "expected": {
        "rotation_deg": 37.5
      }
    },
    "hidden": {
      "surface": { "width": 96, "height": 96 },
      "expected": {
        "all_alpha": 0.0
      }
    },
    "no_no_endpoints": [
      {
        "progress": 0.0,
        "expected_rotation_offset_deg": 0.0
      },
      {
        "progress": 1.0,
        "expected_rotation_offset_deg": 0.0
      }
    ]
  }
}
