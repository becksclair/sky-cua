{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "app_missing",
        "blocked_auth",
        "blocked_portal",
        "blocked_app_state",
        "unable_to_verify",
        "failed"
      ]
    },
    "playlist_name": { "type": "string" },
    "playlist_action": {
      "type": "string",
      "enum": ["created", "reused", "unknown"]
    },
    "song_titles": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "screenshot_path": {
      "type": ["string", "null"]
    },
    "proof_notes": { "type": "string" }
  },
  "required": [
    "status",
    "playlist_name",
    "playlist_action",
    "song_titles",
    "screenshot_path",
    "proof_notes"
  ]
}
